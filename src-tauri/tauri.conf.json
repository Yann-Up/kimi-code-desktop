{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimi Code Desktop",
  "version": "0.5.1",
  "identifier": "com.github.yann.kimi-desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../build/tray.png"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBNTkyNDc5NTFDMUMxRkQKUldUOXdjRlJlU1JaK2prNHh3L3k5UUtlaUpqbzZDVVc1aDZWdW52NDRHeTliVkJYRDZhRklxM1AK",
      "endpoints": [
        "https://cnb.cool/Yann-Up/kimi-code-desktop/-/git/raw/updater/latest.json",
        "https://github.com/Yann-Up/kimi-code-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
